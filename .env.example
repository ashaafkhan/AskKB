
# --- Frontend & Auth (.env for Next.js) ---
# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # Run: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend URL for Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Backend Config (.env for Node.js) ---
PORT=4000

# --- Relational DB ---
DATABASE_URL= # postgres://user:password@host:port/dbname

# --- Vector DB ---
QDRANT_URL= # e.g., http://localhost:6333
QDRANT_API_KEY= # Optional for local docker

# --- LLM Provider (Chat) ---
GROQ_API_KEY=

# --- Embedding Model ---
# Since Groq does not provide embedding APIs, we need a separate provider (e.g. OpenAI)
# OPENAI_API_KEY= 

# --- File/Object Storage (Cloudflare R2) ---
STORAGE_DRIVER=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
R2_ENDPOINT= # e.g. https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=

# --- YouTube Ingestion ---
YOUTUBE_API_KEY= # For fetching metadata

# --- Bonus: Podcast generation (TTS) ---
# ELEVENLABS_API_KEY= # or OPENAI_API_KEY for tts-1
